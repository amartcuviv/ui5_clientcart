<mvc:View
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    controllerName="fioriamlclient.fioritestclient.controller.CreateCustomer">
   
    <Page id="_IDGenPage1"
        title="Crear Nuevo Cliente"
        showNavButton="true"
        navButtonPress="onNavBack">
        <content>
            <f:SimpleForm
                id="customerForm"
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                adjustLabelSpan="false"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="1"
                columnsL="1"
                columnsM="1">

                <f:toolbar>
                <Toolbar id="_IDGenToolbar3">
                <content>
                <ToolbarSpacer id="toolbarspacer"/>
                <Text id="_IDGenText5" text="
                Cliente se guardará en base de datos del sistema." />
                </content>
                </Toolbar>
                </f:toolbar>
               
                <Panel id="IdPanelCliente" visible="true" headerText="Información del Cliente" expandable="true">
                <content>
                    <Label id="_IDGenLabel" text="ID Cliente" required="true"/>
                    <Input id="customerIdInput" value="{CustomerID}" placeholder="ID de cliente"/>
                    
                    <Label id="_IDGenLabel1" text="Nombre" required="true"/>
                    <Input id="nameInput" value="{Name}" placeholder="Nombre completo"/>
                    
                    <Label id="_IDGenLabel2" text="Empresa"/>
                    <Input id="companyInput" value="{Company}" placeholder="Nombre de la empresa"/>
                    
                    <Label id="_IDGenLabel4" text="Fax"/>
                    <Input id="phoneInput" value="{Fax}" placeholder="+ XXX XXX XXX"/>
                    
                   
              

                </content>
                </Panel>
                
            </f:SimpleForm>
        </content>
        
        <footer>
            <Toolbar id="_IDGenToolbar">
                <ToolbarSpacer id="_IDGenToolbarSpacer2"/>
                <Button id="_IDGenButton3" 
                    text="Cancelar" 
                    press="onCancelPress" 
                    type="Transparent"/>
                <Button id="_IDGenButton4" 
                    text="Guardar" 
                    press="onSavePress" 
                    type="Emphasized"/>
            </Toolbar>
        </footer>
        
    </Page>
    
</mvc:View>