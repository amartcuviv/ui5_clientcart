<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
    xmlns:smartTable="sap.ui.comp.smarttable"
    xmlns:core="sap.ui.core"
    controllerName="fioriamlclient.fioritestclient.controller.MainView"
    displayBlock="true">

    <Page id="page" title="Lista de Clientes">
        <VBox id="_IDGenVBox1" fitContainer="true">
            <!-- SmartFilterBar -->
            <smartFilterBar:SmartFilterBar
                id="smartFilterBar"
                entitySet="ZFIORI_CLIENTE"
                persistencyKey="SmartFilter_Explored"
                enableBasicSearch="false">
                <smartFilterBar:controlConfiguration>
                   
                    <smartFilterBar:ControlConfiguration
                        id="_IDGenControlConfiguration2"
                        key="PostalCode"
                        visibleInAdvancedArea="true"
                        preventInitialDataFetchInValueHelpDialog="false" />
                    <smartFilterBar:ControlConfiguration
                        id="_IDGenControlConfiguration3"
                        key="Name"
                        visibleInAdvancedArea="true"
                        preventInitialDataFetchInValueHelpDialog="false" />
                </smartFilterBar:controlConfiguration>
            </smartFilterBar:SmartFilterBar>

            <!-- SmartTable -->
            <smartTable:SmartTable
                id="smartTable"
                width="100%"
                tableType="ResponsiveTable"
                header="Lista de Clientes"
                enableAutoBinding="true"
                showRowCount="true"
                smartFilterId="smartFilterBar"
                entitySet="ZFIORI_CLIENTE"
                useTablePersonalisation="true"
                editable="false"
                editTogglable="false"
                beforeRebindTable="onBeforeRebindTable"
                requestAtLeastFields="Name,Company,PostalCode,Fax"
                initiallyVisibleFields="Name,Company,PostalCode,Fax">
                
                <!-- <smartTable:customToolbar>
                    <OverflowToolbar id="_IDGenOverflowToolbar1" design="Transparent">
                        <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                        <Button
                            id="_IDGenButton1"
                            text="Upload Excel"
                            type="Transparent"
                            icon="sap-icon://upload"
                            press="onUploadExcel"
                        />
                    </OverflowToolbar>
                </smartTable:customToolbar> -->

                <Table id="_IDGenTable1" alternateRowColors="true">
                    <columns>
                        <Column id="_IDGenColumn1">
                            <Text id="_IDGenText1_SF" text="Nombre" />
                        </Column>
                        <Column id="_IDGenColumn2">
                            <Text id="_IDGenText2_SF" text="Compañía" />
                        </Column>
                        <Column id="_IDGenColumn3">
                            <Text id="_IDGenText3_SF" text="Código Postal" />
                        </Column>
                        <Column id="_IDGenColumn4">
                            <Text id="_IDGenText4_SF" text="Fax" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem1">
                            <cells>
                                <Text id="_IDGenText7" text="{Name}" />
                                <Text id="_IDGenText8" text="{Company}" />
                                <Text id="_IDGenText9" text="{PostalCode}" />
                                <Text id="_IDGenText10" text="{Fax}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </smartTable:SmartTable>
        </VBox>
    </Page>
</mvc:View>
